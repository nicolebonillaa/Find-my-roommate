rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function verifiedCSUN() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches(
          '^[^@]+@my\\.csun\\.edu$'
        );
    }

    function ownUser(userId) {
      return verifiedCSUN()
        && request.auth.uid == userId;
    }

    function connectionDoc(connectionId) {
      return get(
        /databases/$(database)/documents/connections/$(connectionId)
      );
    }

    function connectionMember(connectionId) {
      return verifiedCSUN()
        && request.auth.uid in
          connectionDoc(connectionId).data.userIds;
    }

    function reviewDeadlinePassed(connectionId) {
      return connectionDoc(connectionId).data.reviewDeadline != null
        && request.time >=
          connectionDoc(connectionId).data.reviewDeadline;
    }

    function validScore(value) {
      return value is int && value >= 1 && value <= 5;
    }

    function validReviewScores(scores) {
      return scores.keys().hasAll([
          "cleanlinessScore",
          "communicationScore",
          "noiseScore",
          "paymentScore",
          "privacyScore",
          "responsibilityScore"
        ])
        && scores.keys().hasOnly([
          "cleanlinessScore",
          "communicationScore",
          "noiseScore",
          "paymentScore",
          "privacyScore",
          "responsibilityScore"
        ])
        && validScore(scores.cleanlinessScore)
        && validScore(scores.communicationScore)
        && validScore(scores.noiseScore)
        && validScore(scores.paymentScore)
        && validScore(scores.privacyScore)
        && validScore(scores.responsibilityScore);
    }

    function validConnectionConfirmationUpdate() {
      return request.auth.uid in resource.data.userIds
        && resource.data.status == "awaiting_confirmation"
        && request.resource.data.userIds == resource.data.userIds
        && request.resource.data.confirmedBy.size()
          >= resource.data.confirmedBy.size()
        && request.resource.data.confirmedBy.size() <= 2
        && request.auth.uid in request.resource.data.confirmedBy
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            "confirmedBy",
            "status",
            "reviewDeadline"
          ])
        && request.resource.data.status in [
          "awaiting_confirmation",
          "review_open"
        ]
        && (
          request.resource.data.status == "awaiting_confirmation"
          ||
          (
            request.resource.data.status == "review_open"
            && request.resource.data.confirmedBy.size() == 2
            && request.resource.data.reviewDeadline is timestamp
            && resource.data.reviewDeadline == null
          )
        )
        && (
          request.resource.data.reviewDeadline
            == resource.data.reviewDeadline
          ||
          (
            resource.data.reviewDeadline == null
            && request.resource.data.reviewDeadline is timestamp
          )
        );
    }

    function validConnectionEndUpdate() {
      return request.auth.uid in resource.data.userIds
        && request.resource.data.userIds == resource.data.userIds
        && request.resource.data.endedBy == request.auth.uid
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            "endedBy",
            "endedAt",
            "status"
          ])
        && (
          request.resource.data.status == resource.data.status
          ||
          (
            resource.data.reviewDeadline == null
            && request.resource.data.status == "closed"
          )
        );
    }

    match /users/{userId} {
      allow read: if ownUser(userId);

      allow create, update: if ownUser(userId)
        && request.resource.data.id == request.auth.uid
        && request.resource.data.email
          == request.auth.token.email
        && request.resource.data.keys().hasOnly([
          "id",
          "name",
          "email",
          "verificationStatus",
          "createdAt",
          "updatedAt"
        ]);

      allow delete: if false;
    }

    match /profiles/{userId} {
      allow read: if verifiedCSUN();

      allow create, update: if ownUser(userId)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          "userId",
          "displayName",
          "bio",
          "preferences",
          "avatarColor",
          "photoUrl",
          "updatedAt"
        ])
        && request.resource.data.displayName is string
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 2000;

      allow delete: if false;
    }

    match /requests/{requestId} {
      allow create: if verifiedCSUN()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.senderId
          != request.resource.data.receiverId
        && request.resource.data.status == "pending"
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 500;

      allow read: if verifiedCSUN()
        && (
          resource.data.senderId == request.auth.uid
          || resource.data.receiverId == request.auth.uid
        );

      allow update: if verifiedCSUN()
        && resource.data.status == "pending"
        && request.resource.data.senderId
          == resource.data.senderId
        && request.resource.data.receiverId
          == resource.data.receiverId
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            "status",
            "respondedAt",
            "endedAt"
          ])
        && (
          (
            resource.data.receiverId == request.auth.uid
            && request.resource.data.status in [
              "accepted",
              "declined"
            ]
          )
          ||
          (
            resource.data.senderId == request.auth.uid
            && request.resource.data.status == "ended"
          )
        );

      allow delete: if false;
    }

    match /connections/{connectionId} {
      allow read: if verifiedCSUN()
        && request.auth.uid in resource.data.userIds;

      allow create: if verifiedCSUN()
        && request.resource.data.userIds.size() == 2
        && request.auth.uid in request.resource.data.userIds
        && request.resource.data.status
          == "awaiting_confirmation"
        && request.resource.data.confirmedBy.size() == 0
        && request.resource.data.requestId is string
        && getAfter(
          /databases/$(database)/documents/requests/
          $(request.resource.data.requestId)
        ).data.status == "accepted"
        && getAfter(
          /databases/$(database)/documents/requests/
          $(request.resource.data.requestId)
        ).data.senderId in request.resource.data.userIds
        && getAfter(
          /databases/$(database)/documents/requests/
          $(request.resource.data.requestId)
        ).data.receiverId in request.resource.data.userIds;

      allow update: if verifiedCSUN()
        && (
          validConnectionConfirmationUpdate()
          || validConnectionEndUpdate()
        );

      allow delete: if false;
    }

    match /reviews/{reviewId} {
      allow create: if connectionMember(
          request.resource.data.connectionId
        )
        && reviewId
          == request.resource.data.connectionId
          + "_"
          + request.resource.data.reviewerId
        && request.resource.data.reviewerId
          == request.auth.uid
        && request.resource.data.reviewedUserId
          != request.auth.uid
        && request.resource.data.status == "submitted"
        && validReviewScores(request.resource.data.scores)
        && request.resource.data.positiveComment is string
        && request.resource.data.positiveComment.size() <= 1000
        && request.resource.data.futureRoommateComment is string
        && request.resource.data.futureRoommateComment.size() <= 1000
        && connectionDoc(
          request.resource.data.connectionId
        ).data.status == "review_open"
        && request.time < connectionDoc(
          request.resource.data.connectionId
        ).data.reviewDeadline
        && request.resource.data.reviewedUserId
          in connectionDoc(
            request.resource.data.connectionId
          ).data.userIds;

      allow read: if connectionMember(
          resource.data.connectionId
        )
        && (
          resource.data.reviewerId == request.auth.uid
          ||
          (
            resource.data.status == "submitted"
            && (
              exists(
                /databases/$(database)/documents/reviewReveals/
                $(resource.data.connectionId)
              )
              ||
              reviewDeadlinePassed(
                resource.data.connectionId
              )
            )
          )
        );

      allow update: if false;
      allow delete: if false;
    }

    match /reviewReveals/{connectionId} {
      allow read: if connectionMember(connectionId);

      allow create: if connectionMember(connectionId)
        && request.resource.data.connectionId == connectionId
        && request.resource.data.reason == "both_submitted"
        && request.resource.data.otherReviewerId
          != request.auth.uid
        && request.resource.data.otherReviewerId
          in connectionDoc(connectionId).data.userIds
        && getAfter(
          /databases/$(database)/documents/reviews/
          $(connectionId + "_" + request.auth.uid)
        ).data.status == "submitted"
        && get(
          /databases/$(database)/documents/reviews/
          $(connectionId + "_" + request.resource.data.otherReviewerId)
        ).data.status == "submitted";

      allow update: if false;
      allow delete: if false;
    }

    match /reports/{reportId} {
      allow create: if verifiedCSUN()
        && request.resource.data.reporterId
          == request.auth.uid;

      allow read, update, delete: if false;
    }
  }
}